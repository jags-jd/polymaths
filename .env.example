# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `pnpm exec supabase status` after `pnpm db:start`.
# Staging/production values live in Vercel environment variables
# (Preview → polymaths-staging, Production → polymaths-prod).

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only: bypasses RLS, never expose to the browser) ---
SUPABASE_SECRET_KEY=

# --- Migrations to hosted projects (pnpm db:push:staging / db:push:prod) ---
# Project refs from the Supabase dashboard URL. The DB password is asked for
# by the CLI, or set SUPABASE_DB_PASSWORD in your shell — not in a file.
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=

# --- OAuth for LOCAL Supabase (phase 0.2; read by supabase/config.toml) ---
# Hosted projects keep these in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
